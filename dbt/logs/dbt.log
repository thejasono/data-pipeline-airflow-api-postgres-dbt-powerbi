  create  table "db"."public_analytics"."fct_marketing_attribution__dbt_tmp"
  
  
    as
  
  (
    with s as (
  select * from "db"."public_staging"."stg_sessions"
)
select
  session_day,
  source,
  medium,
  coalesce(campaign,'') as campaign,
